# GovCoPilot Server Configuration
PORT=3000

# Groq API Configuration (required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# x402 Payment Configuration
NETWORK=mainnet

# The EVM wallet address that will receive the governance co-pilot usage payments
ASP_WALLET_ADDRESS=0xf313dcef4e1e22c01cea636c2631c74eac6e4518

# Payment cost per call (0.05 USDT0 on X Layer Mainnet)
PAYMENT_AMOUNT=0.05
PAYMENT_TOKEN_ADDRESS=0x779ded0c9e102225f8e0630b35a9b54be713736

# Chain details (196 = X Layer Mainnet, eip155:196)
CHAIN_ID=196
CAIP2_CHAIN_ID=eip155:196
X_LAYER_RPC_URL=https://rpc.xlayer.tech
X_LAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech

# Set to true during development/testing to skip onchain validation
BYPASS_PAYMENT_VERIFICATION=false
